{"version":3,"kind":"Article","sha256":"173b49695cb8c3b347443dc3bfec77cf054c1da371fa6663fa390507365f1a63","slug":"work-life-balance","location":"/6-struggle/personal/work-life-balance.md","dependencies":[],"frontmatter":{"title":"🟡 When work-life balance is lost","authors":[{"id":"Ryan Deaton","name":"Ryan Deaton"}],"date":"2025-12-08","github":"https://github.com/csprayers/csprayers.com","keywords":["prayer","computer science","education","faith"],"numbering":{"title":{"offset":2}},"source_url":"https://github.com/csprayers/csprayers.com/blob/main/6-struggle/personal/work-life-balance.md","edit_url":"https://github.com/csprayers/csprayers.com/edit/main/6-struggle/personal/work-life-balance.md","exports":[{"format":"md","filename":"work-life-balance.md","url":"/work-life-balance-64fa1dd9a30555101fad5c23331d5550.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Out of equilibrium","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"KtaoHE66di"}],"key":"NqS0ovX5xg"}],"key":"BiPmQZi2H3"},{"type":"thematicBreak","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"sk69ILyf9k"},{"type":"blockquote","position":{"start":{"line":11,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Glorious God","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"C2lABPrtKK"}],"key":"CbnqHbmVPA"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Perfect Lord","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"FGZjxEfF4q"}],"key":"zkZ5Sv0xCR"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Creator of all that is Good","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"fLxtrqa8Ov"}],"key":"Dgts4gduvW"}],"key":"lbSpI4xnsk"},{"type":"blockquote","position":{"start":{"line":17,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"We ask for self control so that we do not let our walls be broken down,\nbroken down by the busyness in our lives,\nbroken down by our temptations to do wrong,\nbroken down by choosing not to do what is right even when we know what is right,\nbroken down by letting the world taking control of our lives.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"fc2wSlxOne"}],"key":"GJZKGfcfcZ"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"For we know in life and death,\nWe are yours forever.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ozYWumGOLk"}],"key":"ykClNqc2Ed"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Yours in Eternal Love,\nAnd by your Son, Jesus Christ,\nOur Lord and Saviour.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ikGxpfurU5"}],"key":"d8hXT7TVVN"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Let us be reminded of the sacrifice of our Holy Lord, Jesus Christ,\nSo we may sacrifice the parts of our habits that do not Glorify you, Lord.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"hsiBSk0DkL"}],"key":"PBEQzzjC1j"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Let us sacrifice","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"xzj2LeWOWg"}],"key":"S9WPyLhcrn"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Our Procrastination,\nChoosing to not do what we ought to do,\neven when we know what is right for your Glory,","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"djOXXXZgKl"}],"key":"ptlk8e5LcT"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Our Love for Human Satisfaction,\nChoosing to befriend the world,\nMaking us an enemy of you, God.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"dZPNsc2Nz8"}],"key":"OVtyvAPhtc"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Our selfish ambition,\nWanting to become the lords of our own lives.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"W5y1u3xyRi"}],"key":"aOQGlQxTWJ"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"For we know that you, Lord, are our Father in Heaven,\nOur Protector, Who sent His Son, Christ Jesus, to die for our sin.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"WTOIXIWvzM"}],"key":"yTzAyXVLEG"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Let us Glorify you with our work, all of it that is Good, and for your Glory.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"YgwTS9B2aF"}],"key":"FwhFZtlBHg"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Let us Delight in sacrificing the busyness of this world, for you, God.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"nf8mBltTJi"}],"key":"dSigevSybq"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Keep our eyes fixed on your Wisdom, that above all knowledge in this world,\nYour Wisdom that endures forever, and grants us Eternal Life.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"BU2WlWkJD1"}],"key":"YOFn6uzGLI"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"For we must remember the King of Kings who we work for on this earth,\nThe Lord of our Lives, and the Protector of us.\nWe will not work for the obscure men of this world,\nBut for you, Lord.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"Ee8qbaK95S"}],"key":"Bk2C4lb84S"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"We ask for your Divine Guidance and Wisdom to guide us in the tasks ahead,\nWhich tasks we need to sacrifice, so that we may Glorify you in all that we do.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"OthOPOe5O4"}],"key":"nlpUoxyIUJ"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"We ask for Rest, from the constant motion of this world,\nFor you have shown us what is right, and we alone cannot uphold all things,\nWe put our faith in you Alone, Christ, God, and Holy Spirit.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"WK7LFi43aA"}],"key":"RpSUAAY8X9"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Let the Holy Spirit guide us to doing what is right for you in our every action,\nFor our lives belong completely to you, Lord.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"TS29ygjx1d"}],"key":"DZHaT3Qibu"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"Amen.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"bhKoix0gZP"}],"key":"ZIPNd38sE0"}],"key":"zSWOHKEzM0"}],"key":"um1rq9DxZv"}],"key":"GXBxxHi2g8"},"references":{"cite":{"order":[],"data":{}}}}